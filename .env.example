# Enterprise Library Management System - Production Environment Template
# Copy this file to .env locally, or add these values in Render/Railway.
# Never commit a real .env file or real Supabase credentials.

# Django core
SECRET_KEY=replace-with-a-long-random-production-secret-key
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,your-custom-domain.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://your-custom-domain.com
USE_X_FORWARDED_PROTO=True

# Supabase PostgreSQL
DATABASE_ENGINE=postgresql
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-supabase-database-password
DATABASE_HOST=db.your-project-ref.supabase.co
DATABASE_PORT=5432
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
DATABASE_DISABLE_SERVER_SIDE_CURSORS=False

# If using a Supabase pooler, copy the exact host/user/port from Supabase.
# Session pooler is usually best for Django web apps in IPv4-only hosts.
# Transaction pooler may require DATABASE_DISABLE_SERVER_SIDE_CURSORS=True.
# DATABASE_USER=postgres.your-project-ref
# DATABASE_HOST=aws-0-region.pooler.supabase.com
# DATABASE_PORT=5432

# Supabase Auth
USE_SUPABASE_AUTH=True
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=https://your-app.onrender.com/login/
SUPABASE_AUTH_TIMEOUT=10
SUPABASE_AUTH_DEFAULT_ROLE=Student
SUPABASE_AUTH_REQUIRE_LOCAL_USER=True
SUPABASE_AUTH_SESSION_KEY=supabase_auth

# Static and media files
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
MAX_UPLOAD_SIZE=10485760
PROFILE_IMAGE_MAX_SIZE=5242880
REPORT_UPLOAD_MAX_SIZE=2097152
REPORT_UPLOAD_ALLOWED_EXTENSIONS=.csv
FINE_RATE_PER_DAY=1.00

# Email
DEFAULT_FROM_EMAIL=Library Management System <noreply@example.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_PENDING_TIMEOUT_MINUTES=15
PASSWORD_RESET_TIMEOUT=86400

# API and JWT settings
API_PAGE_SIZE=20
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=False
JWT_BLACKLIST_AFTER_ROTATION=False

# Production security
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Logging
DJANGO_LOG_LEVEL=INFO
LIBRARY_AUDIT_LOG_LEVEL=INFO
LIBRARY_ERROR_LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_MAX_BYTES=1048576
LOG_FILE_BACKUP_COUNT=5

# Local development override example:
# DEBUG=True
# ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# DATABASE_ENGINE=sqlite
# SQLITE_NAME=library.sqlite3
# USE_SUPABASE_AUTH=False
# CSRF_COOKIE_SECURE=False
# SESSION_COOKIE_SECURE=False
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# USE_X_FORWARDED_PROTO=False
